---
const currentYear = new Date().getFullYear();
---

<footer class="bg-nav-bg text-nav-text mt-auto">
  <div class="section-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Lab Info -->
      <div>
        <div class="mb-4">
          <h3 class="font-bold text-lg">MPS Lab</h3>
          <p class="text-sm text-nav-text/60">Making Programming Simple</p>
        </div>
        <p class="text-sm text-nav-text/70 leading-relaxed">
          School of Computing & Augmented Intelligence<br />
          Arizona State University<br />
          Tempe, AZ 85281
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4
          class="font-semibold text-sm uppercase tracking-wider text-nav-text/50 mb-4"
        >
          Quick Links
        </h4>
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
          <li>
            <a
              href="/"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/research"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Research</a
            >
          </li>
          <li>
            <a
              href="/publications"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Publications</a
            >
          </li>
          <li>
            <a
              href="/teaching"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Teaching</a
            >
          </li>
          <li>
            <a
              href="/people"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >People</a
            >
          </li>
          <li>
            <a
              href="/news"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >News</a
            >
          </li>
          <li>
            <a
              href="/gallery"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Gallery</a
            >
          </li>
          <li>
            <a
              href="/faq"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >FAQ</a
            >
          </li>
          <li>
            <a
              href="/contact"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
              >Contact</a
            >
          </li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4
          class="font-semibold text-sm uppercase tracking-wider text-nav-text/50 mb-4"
        >
          Connect
        </h4>
        <ul class="space-y-2">
          <li>
            <a
              href="https://github.com/MPSLab-ASU"
              target="_blank"
              rel="noopener"
              class="text-sm text-nav-text/70 hover:text-white transition-colors"
            >
              GitHub ↗
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-white/10 mt-8 pt-4">
      <div class="flex items-center justify-between gap-4">
        <a
          href="https://www.asu.edu/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Arizona State University"
        >
          <img
            src="/images/asu/asu-logo-white.png"
            alt="Arizona State University"
            class="h-8 w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-xs text-nav-text/50 text-center flex-1">
          © {currentYear} MPS Lab, Arizona State University. All rights reserved.
        </p>
        <a
          href="https://engineering.asu.edu/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Ira A. Fulton Schools of Engineering"
        >
          <img
            src="/images/asu/fulton-logo-white.png"
            alt="Ira A. Fulton Schools of Engineering"
            class="h-8 w-auto object-contain"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
  </div>
</footer>

---
const { currentPath } = Astro.props;

const links = [
    {
        href: "/news",
        label: "Lab Updates",
        icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
    },
    {
        href: "/news/awards",
        label: "Awards",
        icon: "M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z",
    },
];

// Normalize paths for exact matching (e.g., removing trailing slashes)
const normalizePath = (p: string) => p.replace(/\/$/, "") || "/";
const normalizedCurrent = normalizePath(currentPath);
---

<aside class="w-full md:w-64 flex-shrink-0">
    <div class="sticky top-24">
        <h2
            class="text-xs font-semibold text-text-muted uppercase tracking-wider mb-4 px-3"
        >
            News Categories
        </h2>
        <nav class="space-y-1">
            {
                links.map((link) => {
                    const isSelected =
                        normalizedCurrent === normalizePath(link.href);
                    return (
                        <a
                            href={link.href}
                            class:list={[
                                "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200",
                                isSelected
                                    ? "bg-primary text-white shadow-md shadow-primary/20"
                                    : "text-text-secondary hover:bg-bg-alt hover:text-text",
                            ]}
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d={link.icon}
                                />
                            </svg>
                            {link.label}
                        </a>
                    );
                })
            }
        </nav>
    </div>
</aside>

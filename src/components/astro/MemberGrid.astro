---
import { getCollection } from 'astro:content';

interface Props {
  roleFilter?: string;
  researchFilter?: string;
  alumniTypeFilter?: string | string[];
  folderPrefix?: string | string[];
  activeOnly?: boolean;
  compact?: boolean;
}

const {
  roleFilter,
  researchFilter,
  alumniTypeFilter,
  folderPrefix,
  activeOnly = false,
  compact = false,
} = Astro.props;

const normalizedFolderPrefixes = folderPrefix
  ? (Array.isArray(folderPrefix) ? folderPrefix : [folderPrefix]).map((prefix) =>
      prefix.replace(/^\/+|\/+$/g, ''),
    )
  : [];

let allMembers = await getCollection('members');

if (normalizedFolderPrefixes.length > 0) {
  allMembers = allMembers.filter((member) =>
    normalizedFolderPrefixes.some((prefix) => member.slug.startsWith(`${prefix}/`) || member.slug === prefix),
  );
}

if (roleFilter === 'Alumni') {
  allMembers = allMembers.filter(m => m.data.role === 'Alumni' || m.data.isAlumni === true);
} else if (roleFilter) {
  allMembers = allMembers.filter(m => m.data.role === roleFilter);
}
if (alumniTypeFilter) {
  const types = Array.isArray(alumniTypeFilter) ? alumniTypeFilter : [alumniTypeFilter];
  allMembers = allMembers.filter(m => {
    if (!m.data.alumniType) return false;
    const memberTypes = Array.isArray(m.data.alumniType) ? m.data.alumniType : [m.data.alumniType];
    return memberTypes.some(t => types.includes(t));
  });
}

if (activeOnly) {
  // Active status is based on current role/folder, not historical prior-degree metadata.
  allMembers = allMembers.filter(
    (m) =>
      m.data.role !== 'Alumni' &&
      !m.slug.startsWith('alumni/'),
  );
}

if (researchFilter) {
  const filterLower = researchFilter.toLowerCase();
  allMembers = allMembers.filter(m => 
    m.data.researchInterests && 
    m.data.researchInterests.some(ri => ri.toLowerCase() === filterLower)
  );
}
// Determine graduation date value for sorting
const getGraduationValue = (gradStr: string | string[] | undefined): number => {
  if (!gradStr) return 0;
  
  // If array, grab the first one or we can find the max year. Let's just find the max year.
  const strs = Array.isArray(gradStr) ? gradStr : [gradStr];
  let maxValue = 0;

  for (const s of strs) {
    // Example: 'Spring 2024', 'Fall 2023', '2020'
    const match = s.match(/(Spring|Summer|Fall|Winter)?\s*(\d{4})/i);
    if (match) {
      const year = parseInt(match[2], 10);
      let seasonVal = 0;
      const season = (match[1] || '').toLowerCase();
      if (season === 'spring') seasonVal = 1;
      else if (season === 'summer') seasonVal = 2;
      else if (season === 'fall') seasonVal = 3;
      else if (season === 'winter') seasonVal = 4;
      
      // E.g., 2024.3, 2024.1
      const val = year + (seasonVal / 10);
      if (val > maxValue) {
        maxValue = val;
      }
    }
  }
  return maxValue;
}

const isAlumniFolder = normalizedFolderPrefixes.some((prefix) => prefix === 'alumni' || prefix.startsWith('alumni/'));

if (roleFilter === 'Alumni' || alumniTypeFilter || isAlumniFolder) {
  // Sort by graduation (newest to oldest), fallback to order
  allMembers.sort((a, b) => {
    const valA = getGraduationValue(a.data.graduated);
    const valB = getGraduationValue(b.data.graduated);
    
    if (valA !== valB) {
      return valB - valA; // Descending
    }
    return (a.data.order ?? 99) - (b.data.order ?? 99);
  });
} else {
  // Default sorting
  allMembers.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
}

const roleColors: Record<string, string> = {
  'Principle Investigator': 'bg-primary/10 text-primary',
  'Ph.D.': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
  'Masters': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300',
  'Postdoc': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
  'Alumni': 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400',
};
---

{allMembers.length > 0 && compact && (
  <ul class="space-y-3 list-disc list-inside text-text-secondary">
    {allMembers.map((member) => {
      const memberSlug = member.slug.split('/').pop() ?? member.slug;
      return (
        <li>
          <a href={`/members/${memberSlug}`} class="hover:text-primary transition-colors hover:underline text-lg">
            {member.data.name}
          </a>
        </li>
      );
    })}
  </ul>
)}

{allMembers.length > 0 && !compact && (
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  {allMembers.map(async (member) => {
    const memberSlug = member.slug.split('/').pop() ?? member.slug;
    const { Content } = await member.render();
    return (
      <a href={`/members/${memberSlug}`} class="card p-6 block group hover:-translate-y-1 transition-transform">
        {member.data.image || member.data.photoUrl ? (
          <img src={member.data.image || member.data.photoUrl} alt={member.data.name} class="w-20 h-20 mx-auto mb-4 rounded-full object-cover shadow-sm bg-white dark:bg-transparent border-2 border-black dark:border-white" />
        ) : (
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-2xl font-bold text-primary shadow-sm border-2 border-primary/20">
            {member.data.name.split(' ').map((n: string) => n[0]).join('')}
          </div>
        )}

        <!-- Info -->
        <h3 class="text-center font-semibold text-lg text-text mb-1">{member.data.name}</h3>
        <div class="text-center mb-3">
          <span class:list={['badge', roleColors[member.data.role] ?? 'bg-gray-100 text-gray-600']}>
            {member.data.role}
          </span>
        </div>

        {(member.data.graduated || member.data.alumniType) && (
          <div class="mb-3 text-center">
            <p class="text-xs font-medium text-text-secondary">
              {member.data.graduated && (Array.isArray(member.data.graduated) 
                ? member.data.graduated.map((g: string) => <span class="block text-text-muted">Graduated: {g}</span>) 
                : <span class="block text-text-muted">Graduated: {member.data.graduated}</span>)}
            </p>
          </div>
        )}

        {(member.data.university || member.data.duration) && (
          <div class="mb-3 text-center text-xs">
            {member.data.university && (Array.isArray(member.data.university)
              ? member.data.university.map((u: string) => <p class="font-medium text-text-secondary mb-0.5">{u}</p>)
              : <p class="font-medium text-text-secondary mb-0.5">{member.data.university}</p>)}
            {member.data.duration && (Array.isArray(member.data.duration)
              ? member.data.duration.map((d: string) => <p class="text-text-muted">{d}</p>)
              : <p class="text-text-muted">{member.data.duration}</p>)}
          </div>
        )}

        {member.data.currentPosition && (
          <div class="mb-3 text-center">
             <p class="text-xs text-text-secondary" title={member.data.currentPosition}>{member.data.currentPosition}</p>
          </div>
        )}

        {member.data.researchInterests && member.data.researchInterests.length > 0 && (
          <div class="mb-3">
             <h4 class="text-[10px] font-semibold text-text-muted uppercase tracking-wider text-center mb-1.5 pt-2 border-t border-border">Research Areas</h4>
             <div class="flex flex-wrap gap-1 justify-center">
                {member.data.researchInterests.slice(0, 3).map(tag => (
                  <span class="text-xs text-text-secondary bg-bg-alt border border-border px-2 py-0.5 rounded text-center leading-tight">{tag}</span>
                ))}
             </div>
          </div>
        )}

        {member.data.email && (
          <p class="text-center text-xs text-text-muted truncate">{member.data.email}</p>
        )}

      </a>
    );
  })}
  </div>
)}

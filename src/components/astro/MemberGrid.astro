---
import { getCollection } from 'astro:content';

interface Props {
  roleFilter?: string;
}

const { roleFilter } = Astro.props;

let allMembers = await getCollection('members');
if (roleFilter) {
  allMembers = allMembers.filter(m => m.data.role === roleFilter);
}
allMembers.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const roleColors: Record<string, string> = {
  'Faculty': 'bg-primary/10 text-primary',
  'Ph.D.': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300',
  'Masters': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300',
  'Postdoc': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300',
  'Alumni': 'bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400',
};
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  {allMembers.map(async (member) => {
    const { Content } = await member.render();
    return (
      <a href={`/members/${member.slug}`} class="card p-6 block group hover:-translate-y-1 transition-transform">
        <!-- Avatar -->
        {member.data.image || member.data.photoUrl ? (
          <img src={member.data.image || member.data.photoUrl} alt={member.data.name} class="w-20 h-20 mx-auto mb-4 rounded-full object-cover shadow-sm bg-white border-2 border-primary/20" />
        ) : (
          <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-2xl font-bold text-primary shadow-sm border-2 border-primary/20">
            {member.data.name.split(' ').map((n: string) => n[0]).join('')}
          </div>
        )}

        <!-- Info -->
        <h3 class="text-center font-semibold text-lg text-text mb-1">{member.data.name}</h3>
        <div class="text-center mb-3">
          <span class:list={['badge', roleColors[member.data.role] ?? 'bg-gray-100 text-gray-600']}>
            {member.data.role}
          </span>
        </div>

        {member.data.researchInterests && member.data.researchInterests.length > 0 && (
          <div class="mb-3">
             <h4 class="text-[10px] font-semibold text-text-muted uppercase tracking-wider text-center mb-1.5 pt-2 border-t border-border">Research Areas</h4>
             <div class="flex flex-wrap gap-1 justify-center">
                {member.data.researchInterests.slice(0, 3).map(tag => (
                  <span class="text-xs text-text-secondary bg-bg-alt border border-border px-2 py-0.5 rounded text-center leading-tight">{tag}</span>
                ))}
             </div>
          </div>
        )}

        {member.data.email && (
          <p class="text-center text-xs text-text-muted truncate">{member.data.email}</p>
        )}

      </a>
    );
  })}
</div>

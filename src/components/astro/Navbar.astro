---
import { getCollection } from "astro:content";
import ThemeToggle from "../react/ThemeToggle";
interface NavItem {
  href: string;
  label: string;
  children?: Array<{ href: string; label: string }>;
  iconPath?: string;
}

const navLinks = [
  { href: "/", label: "Home" },
  {
    href: "/research",
    label: "Research",
    children: [],
  },
  { href: "/publications", label: "Publications" },
  {
    href: "/software",
    label: "Software",
  },
  {
    href: "/people",
    label: "People",
    children: [
      { href: "/people", label: "Current Members" },
      { href: "/people?view=alumni", label: "Alumni" },
      {
        href: "/people?view=visiting-students#visiting-students-list",
        label: "Visiting Students",
      },
      {
        href: "/people?view=visiting-faculty#visiting-faculty-list",
        label: "Visiting Faculty",
      },
    ],
  },
  {
    href: "/news",
    label: "Updates",
    children: [
      { href: "/news", label: "Lab Updates" },
      { href: "/news/awards", label: "Awards" },
      { href: "/news/grants", label: "Grants" },
    ],
  },
  { href: "/gallery", label: "Gallery" },
  { href: "/faq", label: "FAQ" },
  { href: "/contact", label: "Contact" },
] as NavItem[];

const allResearch = await getCollection("research");
const activeResearch = allResearch
  .filter((entry) => entry.data.status === "Active")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const researchNav = navLinks.find((link) => link.href === "/research");
if (researchNav) {
  researchNav.children = [
    ...activeResearch.map((entry) => ({
      href: `/research/${entry.slug}`,
      label: entry.data.title,
    })),
    {
      href: "/research#extended-research",
      label: "Extended Research Areas",
    },
  ];
}

const currentPath = Astro.url.pathname;
const isActivePath = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(`${href}/`));
---

<nav
  class="bg-nav-bg text-nav-text sticky top-0 z-50 shadow-lg backdrop-blur-sm border-b border-border"
>
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Logo / Lab Name -->
      <div class="flex items-center gap-3">
        <a
          href="https://www.asu.edu/"
          target="_blank"
          rel="noopener noreferrer"
          class="group"
          aria-label="Arizona State University"
        >
          <img
            src="/images/asu/asu-logo-color.png"
            alt="Arizona State University logo"
            class="h-10 md:h-12 w-auto object-contain group-hover:scale-[1.02] transition-transform"
            loading="eager"
            decoding="async"
          />
        </a>
        <div class="leading-tight">
          <a href="/" class="font-bold text-base md:text-lg tracking-tight hover:text-primary transition-colors">
            MPS Lab at ASU
          </a>
          <a
            href="https://engineering.asu.edu/"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden md:block text-xs text-text-muted hover:text-primary transition-colors"
          >
            Ira A. Fulton School of Engineering
          </a>
        </div>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        {
          navLinks.map((link) => {
            const baseClass = [
              "px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 inline-flex items-center gap-1 border-b-2 border-transparent",
              isActivePath(link.href)
                ? "text-primary border-primary"
                : "text-nav-text/75 hover:text-primary hover:border-primary/60",
            ];

            if (!link.children) {
              return (
                <a href={link.href} class:list={baseClass}>
                  {link.iconPath && (
                    <svg
                      class="w-4 h-4"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path d={link.iconPath} />
                    </svg>
                  )}
                  {link.label}
                </a>
              );
            }

            return (
              <div class="relative group">
                <a href={link.href} class:list={baseClass}>
                  {link.label}
                  <svg
                    class="w-3.5 h-3.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </a>

                <div class="absolute left-0 top-full pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150">
                  <div class="rounded-xl border border-border bg-bg shadow-xl p-2">
                    {link.children.map((child) => (
                      <a
                        href={child.href}
                        class="block px-3 py-2 rounded-lg text-sm text-text-secondary hover:text-primary"
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            );
          })
        }
        <div class="ml-3 pl-3 border-l border-border">
          <ThemeToggle client:only="react" />
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden flex items-center space-x-2">
        <ThemeToggle client:only="react" />
        <button
          id="mobile-menu-btn"
          class="p-2 rounded-lg hover:bg-bg-alt transition-colors"
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="md:hidden hidden pb-4">
      <div class="space-y-1 pt-2 border-t border-border">
        {
          navLinks.map((link) => (
            <div>
              <a
                href={link.href}
                class:list={[
                  "block px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 border-l-2 border-transparent",
                  isActivePath(link.href)
                    ? "text-primary border-primary"
                    : "text-nav-text/75 hover:text-primary hover:border-primary/60",
                ]}
              >
                {link.iconPath && (
                  <svg
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d={link.iconPath} />
                  </svg>
                )}
                {link.label}
              </a>

              {link.children && (
                <div class="ml-4 mt-1 space-y-1">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class="block px-4 py-2 rounded-lg text-sm text-nav-text/70 hover:text-primary"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>

---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import Footer from "../../components/astro/Footer.astro";
import Navbar from "../../components/astro/Navbar.astro";
import type { Publication } from "../../components/react/PublicationCard";
import Layout from "../../layouts/Layout.astro";
import { withDisplayTitles } from "../../utils/bibtex";

export async function getStaticPaths() {
  const memberEntries = await getCollection("members");
  return memberEntries.map((entry) => ({
    params: { slug: entry.slug.split("/").pop() },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const researchEntries = await getCollection("research");

const roleColors: Record<string, string> = {
  Faculty: "bg-primary/10 text-primary",
  "Ph.D.": "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
  Masters:
    "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
  Postdoc:
    "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
  Alumni: "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400",
};

// Build-time BibTeX parsing
const bibPath = path.join(process.cwd(), "src/data/publications.bib");
let parsedBib: Publication[] = [];
try {
  const bibContent = fs.readFileSync(bibPath, "utf-8");
  // @ts-ignore - bibtex-parse-js doesn't have proper types
  const bibtexParse = await import("bibtex-parse-js");
  parsedBib = withDisplayTitles(bibtexParse.toJSON(bibContent));
} catch (e) {
  console.error("Error parsing bibtex:", e);
}

// Filter for related publications based on the author name matching the member's name
const memberNameLower = entry.data.name.toLowerCase();
const relatedPublications = parsedBib
  .filter((pub) => {
    if (!pub.entryTags.author) return false;
    return pub.entryTags.author.toLowerCase().includes(memberNameLower);
  })
  .sort((a, b) => {
    // Sort by descending year
    const yearA = a.entryTags.year ? parseInt(a.entryTags.year) : 0;
    const yearB = b.entryTags.year ? parseInt(b.entryTags.year) : 0;
    return yearB - yearA;
  })
  .slice(0, 5); // Take top 5
---

<Layout title={entry.data.name}>
  <Navbar slot="header" />

  <section class="py-16 md:py-24">
    <div class="section-container max-w-4xl">
      <!-- Header -->
      <header
        class="mb-12 border-b border-border pb-8 text-center sm:text-left flex flex-col sm:flex-row items-center sm:items-start gap-8"
      >
        <div class="flex-shrink-0">
          {
            entry.data.image || entry.data.photoUrl ? (
              <img
                src={entry.data.image || entry.data.photoUrl}
                alt={entry.data.name}
                class="w-48 h-48 rounded-2xl object-cover shadow-lg bg-white dark:bg-transparent border-2 border-black dark:border-white"
              />
            ) : (
              <div class="w-48 h-48 rounded-2xl bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center text-6xl font-bold text-primary shadow-lg border border-border">
                {entry.data.name
                  .split(" ")
                  .map((n: string) => n[0])
                  .join("")}
              </div>
            )
          }
        </div>

        <div class="flex-grow pt-2">
          <div
            class="flex items-center gap-3 mb-4 justify-center sm:justify-start"
          >
            <span
              class:list={[
                "badge",
                roleColors[entry.data.role] ?? "bg-gray-100 text-gray-600",
              ]}
            >
              {entry.data.role}
            </span>
            {
              entry.data.joinDate && (
                <span class="text-sm text-text-secondary">
                  Joined {entry.data.joinDate}
                </span>
              )
            }
          </div>
          <h1
            class="text-3xl md:text-5xl font-bold text-text mb-4 tracking-tight leading-tight"
          >
            {entry.data.name}
          </h1>

          <div
            class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 text-text-secondary w-fit mx-auto sm:mx-0"
          >
            {
              entry.data.email && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                  <a
                    href={`mailto:${entry.data.email}`}
                    class="hover:text-primary transition-colors"
                  >
                    {entry.data.email}
                  </a>
                </div>
              )
            }
            {
              entry.data.website && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                    />
                  </svg>
                  <a
                    href={entry.data.website}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    Personal Website ↗
                  </a>
                </div>
              )
            }
            {
              entry.data.portfolio && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                    />
                  </svg>
                  <a
                    href={entry.data.portfolio}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    Portfolio ↗
                  </a>
                </div>
              )
            }
            {
              entry.data.github && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    />
                  </svg>
                  <a
                    href={entry.data.github}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    GitHub ↗
                  </a>
                </div>
              )
            }
            {
              entry.data.linkedin && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                    />
                  </svg>
                  <a
                    href={entry.data.linkedin}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    LinkedIn ↗
                  </a>
                </div>
              )
            }
            {
              entry.data.resume && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                  <a
                    href={entry.data.resume}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    Resume ↗
                  </a>
                </div>
              )
            }
            {
              entry.data.google_scholar && (
                <div class="flex items-center justify-center sm:justify-start gap-2">
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"
                    />
                  </svg>
                  <a
                    href={entry.data.google_scholar}
                    target="_blank"
                    rel="noopener"
                    class="hover:text-primary transition-colors"
                  >
                    Google Scholar ↗
                  </a>
                </div>
              )
            }
          </div>

          {
            entry.data.researchInterests && (
              <div class="mt-6">
                <h3 class="text-sm font-semibold text-text-secondary uppercase tracking-wider mb-3 text-center sm:text-left">
                  Research Areas
                </h3>
                <div class="flex flex-wrap gap-2 justify-center sm:justify-start">
                  {entry.data.researchInterests.map((tag: string) => {
                    const matchingResearch = researchEntries.find(
                      (r) => r.data.title.toLowerCase() === tag.toLowerCase(),
                    );

                    if (matchingResearch) {
                      return (
                        <a
                          href={`/research/${matchingResearch.slug}`}
                          class="text-xs text-text border border-border bg-bg-alt px-3 py-1 rounded-full hover:border-primary hover:text-primary transition-colors cursor-pointer"
                        >
                          {tag}
                        </a>
                      );
                    }

                    return (
                      <span class="text-xs text-text border border-border bg-bg-alt px-3 py-1 rounded-full">
                        {tag}
                      </span>
                    );
                  })}
                </div>
              </div>
            )
          }
        </div>
      </header>

      {
        entry.data.role === "Principle Investigator" && (
          <section class="mb-10 p-5 rounded-xl border border-border bg-bg-alt/60">
            <h2 class="text-lg font-semibold text-text mb-2">Teaching</h2>
            <p class="text-text-secondary mb-4">
              Courses taught by Prof. Aviral Shrivastava.
            </p>
            <a
              href="/teaching"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary text-white font-medium hover:bg-primary-hover transition-colors"
            >
              View Teaching
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>
          </section>
        )
      }

      <!-- Content -->
      <article
        class="prose prose-lg dark:prose-invert prose-headings:font-heading prose-headings:font-semibold prose-img:rounded-xl prose-a:text-primary hover:prose-a:text-primary-hover max-w-none"
      >
        <Content />
      </article>

      {
        relatedPublications.length > 0 && (
          <div class="mt-16 pt-12 border-t border-border">
            <h2 class="text-2xl font-bold text-text mb-8">
              Recent Publications
            </h2>
            <ul class="space-y-3 list-disc list-inside text-text-secondary">
              {relatedPublications.map((pub) => (
                <li>
                  <a
                    href={`/publications?q=${encodeURIComponent(pub.entryTags.displayTitle || pub.entryTags.title || "")}`}
                    class="hover:text-primary transition-colors hover:underline"
                  >
                    {pub.entryTags.displayTitle ||
                      pub.entryTags.title ||
                      pub.citationKey}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

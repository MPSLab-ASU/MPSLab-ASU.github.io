---
import Footer from "../components/astro/Footer.astro";
import Navbar from "../components/astro/Navbar.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact">
  <Navbar slot="header" />

  <section class="py-16 md:py-24">
    <div class="section-container">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
          Contact Us
        </h1>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Interested in our research or looking to collaborate? Get in touch
          with MPS Lab.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
        <!-- Contact Information -->
        <div class="space-y-8">
          <div class="card p-6">
            <h2 class="font-semibold text-lg text-text mb-4">Lab Director</h2>
            <div class="space-y-2 text-sm text-text-secondary">
              <p><strong class="text-text">Dr. Aviral Shrivastava</strong></p>
              <p>Professor, School of Computing & Augmented Intelligence</p>
              <p>
                <a
                  href="mailto:aviral.shrivastava@asu.edu"
                  class="text-primary hover:underline"
                >
                  aviral.shrivastava@asu.edu
                </a>
              </p>
            </div>
          </div>

          <div class="card p-6">
            <h2 class="font-semibold text-lg text-text mb-4">Lab Location</h2>
            <div class="space-y-3 text-sm text-text-secondary">
              <p><strong class="text-text">MPS Lab</strong></p>
              <p>School of Computing & Augmented Intelligence</p>
              <p>Arizona State University</p>
              <p>
                <a
                  href="http://www.asu.edu/map/interactive/?campus=tempe&building=CTRPT"
                  >Centerpoint Building</a
                >, Office 203-15
              </p>
              <p>660 S. Mill Ave</p>
              <p>Tempe, AZ 85281</p>
            </div>
            <div class="mt-5 rounded-lg overflow-hidden border border-border">
              <iframe
                title="MPS Lab Location"
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d416.2472352137792!2d-111.94136859898566!3d33.423821000000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x872b09cdca978c55%3A0x7ea578c9e10706b7!2sCompiler%20Microarchitecture%20Lab!5e0!3m2!1sen!2sus!4v1780893384985!5m2!1sen!2sus"
                class="w-full h-64"
                style="border:0;"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          </div>

          <div class="card p-6">
            <h2 class="font-semibold text-lg text-text mb-4">Useful Links</h2>
            <ul class="space-y-2 text-sm">
              <li>
                <a
                  href="https://github.com/MPSLab-ASU"
                  target="_blank"
                  rel="noopener"
                  class="text-primary hover:underline">GitHub Organization ↗</a
                >
              </li>
              <li>
                <a
                  href="https://scai.engineering.asu.edu/"
                  target="_blank"
                  rel="noopener"
                  class="text-primary hover:underline"
                  >School of Computing & AI ↗</a
                >
              </li>
            </ul>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <div class="card p-6">
            <h2 class="font-semibold text-lg text-text mb-4">Send a Message</h2>
            <p class="text-sm text-text-secondary mb-6">
              Use the form below to reach out to us. We typically respond within
              2–3 business days. Resume and Transcripts are not required at this
              stage, but feel free to include.
            </p>
            <div class="w-full rounded-lg overflow-hidden border border-border">
              <iframe
                title="MPS Lab Contact Form"
                src="https://docs.google.com/forms/d/e/1FAIpQLSecfLtkUW_mCoX9SYtiR6whK_inYu8SG2rErIFJIhRd_kNnmw/viewform?embedded=true"
                class="w-full h-[1400px] md:h-[1280px] lg:h-[500px]"
                loading="lazy"
              >
                Loading…
              </iframe>
            </div>
            <p class="text-xs text-text-muted mt-3">
              If the form still appears cropped, open it directly:
              <a
                href="https://docs.google.com/forms/d/e/1FAIpQLSecfLtkUW_mCoX9SYtiR6whK_inYu8SG2rErIFJIhRd_kNnmw/viewform"
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary hover:underline"
              >
                Open Google Form ↗
              </a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

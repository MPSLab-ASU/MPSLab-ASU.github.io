---
import Footer from "../components/astro/Footer.astro";
import MemberGrid from "../components/astro/MemberGrid.astro";
import Navbar from "../components/astro/Navbar.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const members = await getCollection("members");

const byFolderPrefix = (prefix: string) =>
  members.filter(
    (member) => member.slug === prefix || member.slug.startsWith(`${prefix}/`),
  );

const hasFolderMembers = (prefix: string) => byFolderPrefix(prefix).length > 0;

const hasAlumniType = (types: string[]) =>
  byFolderPrefix("alumni").some((member) => {
    const alumniType = member.data.alumniType;
    if (!alumniType) return false;
    const memberTypes = Array.isArray(alumniType) ? alumniType : [alumniType];
    return memberTypes.some((t) => types.includes(t));
  });

const hasPI = hasFolderMembers("pi");
const hasCurrentPhD = hasFolderMembers("current/phd");
const hasCurrentMasters = hasFolderMembers("current/masters");
const hasCurrentUndergrad = hasFolderMembers("current/undergraduate");
const hasCurrentAny =
  hasPI || hasCurrentPhD || hasCurrentMasters || hasCurrentUndergrad;

const hasAlumniPostdocs = hasAlumniType([
  "Post-Doctoral Researchers",
  "Post-Doctoral Researcher",
]);
const hasAlumniPhD = hasAlumniType(["Ph.D. Graduates", "Ph.D. Graduate"]);
const hasAlumniMasters = hasAlumniType([
  "Master’s Graduates",
  "Master’s Graduate",
]);
const hasAlumniUndergrad = hasAlumniType([
  "Undergraduate Researchers",
  "Undergraduate Researcher",
]);
const hasAlumniAny =
  hasAlumniPostdocs || hasAlumniPhD || hasAlumniMasters || hasAlumniUndergrad;

const hasVisitingStudents = hasFolderMembers("visiting/students");
const hasVisitingFaculty = hasFolderMembers("visiting/faculty");
---

<Layout title="People">
  <Navbar slot="header" />

  <section class="py-16 md:py-24">
    <div class="section-container">
      <div class="text-center mb-12">
        <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">Our Team</h1>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Meet the researchers and students driving innovation at MPS Lab. Click
          on a member to learn more about their work.
        </p>
      </div>

      <div
        class="grid grid-cols-1 md:grid-cols-[14rem_1fr] lg:grid-cols-[16rem_1fr] gap-8 lg:gap-12 items-start text-sm w-full"
      >
        <!-- Sidebar -->
        <aside class="w-full relative">
          <div class="sticky top-24 flex flex-col gap-2 w-full pr-4 md:pr-0">
            {
              hasCurrentAny && (
                <button
                  id="btn-current"
                  class="text-left px-4 py-3 rounded-xl transition-all font-medium bg-primary text-white shadow-md"
                >
                  Current Members
                </button>
              )
            }
            {
              hasAlumniAny && (
                <button
                  id="btn-alumni"
                  class="text-left px-4 py-3 rounded-xl transition-all font-medium text-text-secondary hover:bg-bg-alt hover:text-text"
                >
                  Alumni
                </button>
              )
            }
            {
              hasVisitingStudents && (
                <button
                  id="btn-visiting-students"
                  class="text-left px-4 py-3 rounded-xl transition-all font-medium text-text-secondary hover:bg-bg-alt hover:text-text"
                >
                  Visiting Students
                </button>
              )
            }
            {
              hasVisitingFaculty && (
                <button
                  id="btn-visiting-faculty"
                  class="text-left px-4 py-3 rounded-xl transition-all font-medium text-text-secondary hover:bg-bg-alt hover:text-text"
                >
                  Visiting Faculty
                </button>
              )
            }
          </div>
        </aside>

        <!-- Content Area -->
        <div class="flex-grow">
          <!-- Current Members Tab -->
          <div id="tab-current" class="tab-content block">
            {
              (hasCurrentPhD || hasCurrentMasters || hasCurrentUndergrad) && (
                <div class="mb-8 flex flex-wrap gap-3">
                  {hasCurrentPhD && (
                    <a
                      href="#phd-students"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Ph.D.
                    </a>
                  )}
                  {hasCurrentMasters && (
                    <a
                      href="#masters-students"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Master's
                    </a>
                  )}
                  {hasCurrentUndergrad && (
                    <a
                      href="#undergraduate-students"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Undergraduate
                    </a>
                  )}
                </div>
              )
            }

            <!-- Faculty -->
            {
              hasPI && (
                <div class="mb-16">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-primary rounded-full" />
                    Principle Investigator
                  </h2>
                  <MemberGrid folderPrefix="pi" />
                </div>
              )
            }

            <!-- Current Students -->
            {
              hasCurrentPhD && (
                <div id="phd-students" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-accent rounded-full" />
                    Ph.D. Students
                  </h2>
                  <MemberGrid folderPrefix="current/phd" />
                </div>
              )
            }

            {
              hasCurrentMasters && (
                <div id="masters-students" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-green-500 rounded-full" />
                    Master's Students
                  </h2>
                  <MemberGrid folderPrefix="current/masters" />
                </div>
              )
            }

            {
              hasCurrentUndergrad && (
                <div id="undergraduate-students" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-purple-500 rounded-full" />
                    Undergraduate Students
                  </h2>
                  <MemberGrid folderPrefix="current/undergraduate" />
                </div>
              )
            }
          </div>

          <!-- Alumni Tab -->
          <div id="tab-alumni" class="tab-content hidden">
            {
              hasAlumniAny && (
                <div class="mb-8 flex flex-wrap gap-3">
                  {hasAlumniPostdocs && (
                    <a
                      href="#alumni-postdocs"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Postdocs
                    </a>
                  )}
                  {hasAlumniPhD && (
                    <a
                      href="#alumni-phd-graduates"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Ph.D. Graduates
                    </a>
                  )}
                  {hasAlumniMasters && (
                    <a
                      href="#alumni-masters-graduates"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Master's Graduates
                    </a>
                  )}
                  {hasAlumniUndergrad && (
                    <a
                      href="#alumni-undergraduate-researchers"
                      class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
                    >
                      Jump to Undergraduate Researchers
                    </a>
                  )}
                </div>
              )
            }

            <!-- Post-docs -->
            {
              hasAlumniPostdocs && (
                <div id="alumni-postdocs" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-purple-500 rounded-full" />
                    Post-Doctoral Researchers
                  </h2>
                  <MemberGrid
                    folderPrefix="alumni"
                    alumniTypeFilter={[
                      "Post-Doctoral Researchers",
                      "Post-Doctoral Researcher",
                    ]}
                  />
                </div>
              )
            }

            <!-- Ph.D. -->
            {
              hasAlumniPhD && (
                <div id="alumni-phd-graduates" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-blue-500 rounded-full" />
                    Ph.D. Graduates
                  </h2>
                  <MemberGrid
                    folderPrefix="alumni"
                    alumniTypeFilter={["Ph.D. Graduates", "Ph.D. Graduate"]}
                  />
                </div>
              )
            }

            <!-- Masters -->
            {
              hasAlumniMasters && (
                <div id="alumni-masters-graduates" class="mb-16 scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-green-500 rounded-full" />
                    Master's Graduates
                  </h2>
                  <MemberGrid
                    folderPrefix="alumni"
                    alumniTypeFilter={[
                      "Master’s Graduates",
                      "Master’s Graduate",
                    ]}
                  />
                </div>
              )
            }

            <!-- Undergraduates -->
            {
              hasAlumniUndergrad && (
                <div
                  id="alumni-undergraduate-researchers"
                  class="mb-16 scroll-mt-28"
                >
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-text-muted rounded-full" />
                    Undergraduate Researchers
                  </h2>
                  <MemberGrid
                    folderPrefix="alumni"
                    alumniTypeFilter={[
                      "Undergraduate Researchers",
                      "Undergraduate Researcher",
                    ]}
                  />
                </div>
              )
            }
          </div>

          <!-- Visiting Students Tab -->
          {
            hasVisitingStudents && (
              <div id="tab-visiting-students" class="tab-content hidden">
                <div id="visiting-students-list" class="scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-blue-500 rounded-full" />
                    Visiting Students
                  </h2>
                  <MemberGrid folderPrefix="visiting/students" />
                </div>
              </div>
            )
          }

          <!-- Visiting Faculty Tab -->
          {
            hasVisitingFaculty && (
              <div id="tab-visiting-faculty" class="tab-content hidden">
                <div id="visiting-faculty-list" class="scroll-mt-28">
                  <h2 class="text-2xl font-bold text-text mb-6 flex items-center gap-3">
                    <span class="w-1 h-8 bg-orange-500 rounded-full" />
                    Visiting Faculty
                  </h2>
                  <MemberGrid folderPrefix="visiting/faculty" />
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script>
  function setupTabs() {
    const tabs = [
      "current",
      "alumni",
      "visiting-students",
      "visiting-faculty",
    ].filter(
      (tab) =>
        Boolean(document.getElementById(`btn-${tab}`)) &&
        Boolean(document.getElementById(`tab-${tab}`)),
    );
    const baseClass =
      "text-left px-4 py-3 rounded-xl transition-all font-medium text-text-secondary hover:bg-bg-alt hover:text-text";
    const activeClass =
      "text-left px-4 py-3 rounded-xl transition-all font-medium bg-primary text-white shadow-md";

    const activateTab = (tab: string) => {
      document.querySelectorAll(".tab-content").forEach((el) => {
        el.classList.remove("block");
        el.classList.add("hidden");
      });

      tabs.forEach((t) => {
        const b = document.getElementById(`btn-${t}`);
        if (b) b.className = baseClass;
      });

      const content = document.getElementById(`tab-${tab}`);
      if (content) {
        content.classList.remove("hidden");
        content.classList.add("block");
      }

      const activeBtn = document.getElementById(`btn-${tab}`);
      if (activeBtn) activeBtn.className = activeClass;
    };

    const maybeScrollToHash = () => {
      const hash = window.location.hash.replace("#", "");
      if (!hash) return;
      const target = document.getElementById(hash);
      if (target) {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    };

    const applyStateFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const requestedView = params.get("view");
      const hash = window.location.hash.replace("#", "");

      if (tabs.length === 0) return;

      if (requestedView && tabs.includes(requestedView)) {
        activateTab(requestedView);
      } else if (!document.querySelector(".tab-content.block")) {
        activateTab(tabs[0]);
      }

      if (
        ["phd-students", "masters-students", "undergraduate-students"].includes(
          hash,
        )
      ) {
        activateTab("current");
      }

      if (
        [
          "alumni-postdocs",
          "alumni-phd-graduates",
          "alumni-masters-graduates",
          "alumni-undergraduate-researchers",
        ].includes(hash)
      ) {
        activateTab("alumni");
      }

      if (["visiting-students-list"].includes(hash)) {
        activateTab("visiting-students");
      }

      if (["visiting-faculty-list"].includes(hash)) {
        activateTab("visiting-faculty");
      }

      maybeScrollToHash();
    };

    tabs.forEach((tab) => {
      const btn = document.getElementById(`btn-${tab}`);
      if (btn) {
        btn.addEventListener("click", () => {
          activateTab(tab);
        });
      }
    });

    applyStateFromUrl();
    window.addEventListener("hashchange", applyStateFromUrl);
  }

  // Setup on initial load
  setupTabs();

  // Re-setup after Astro page transitions
  document.addEventListener("astro:page-load", setupTabs);
</script>

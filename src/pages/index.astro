---
import { getCollection } from "astro:content";
import fs from "node:fs";
import path from "node:path";
import Footer from "../components/astro/Footer.astro";
import Navbar from "../components/astro/Navbar.astro";
import HomepageCarousel from "../components/react/HomepageCarousel";
import Layout from "../layouts/Layout.astro";

// Utility function to randomly select items from an array
function getRandomItems<T>(array: T[], count: number): T[] {
  const shuffled = [...array].sort(() => Math.random() - 0.5);
  return shuffled.slice(0, Math.min(count, array.length));
}

const sponsors = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), "src/data/sponsors.json"), "utf-8"),
);

const news = (await getCollection("news")).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);

const allResearch = await getCollection("research");
const activeResearch = allResearch
  .filter((r) => r.data.status === "Active")
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const allHomepageImages = fs
  .readdirSync(path.join(process.cwd(), "public/images/homepage"))
  .filter((file) => /\.(jpe?g)$/i.test(file))
  .sort((a, b) => a.localeCompare(b))
  .map((file, index) => ({
    src: `/images/homepage/${file}`,
    alt: `MPS Lab homepage image ${index + 1}`,
  }));

// Randomly select 3 images for the carousel
const homepageImages = getRandomItems(allHomepageImages, 3);

const typeColors: Record<string, string> = {
  Award:
    "bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300",
  Grant:
    "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300",
  Publication:
    "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
  Event: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
  Announcement:
    "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
  General: "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400",
};
---

<Layout title="Home">
  <Navbar slot="header" />

  <!-- Hero Section -->
  <section
    class="relative overflow-hidden bg-hero text-hero-text border-b border-border"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(14,165,233,0.14),transparent_30%),radial-gradient(circle_at_bottom_left,rgba(217,119,6,0.12),transparent_30%)]"
    >
    </div>
    <div class="section-container relative z-10 py-12 md:py-18">
      <div
        class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.95fr)]"
      >
        <div class="max-w-3xl">
          <p
            class="mb-4 text-sm font-semibold uppercase tracking-[0.3em] text-primary/80 animate-fade-in"
            style="animation-delay: 0.15s"
          >
            Arizona State University
          </p>
          <h1
            class="text-4xl md:text-6xl font-extrabold mb-5 leading-[1.05] animate-fade-in"
            style="animation-delay: 0.2s"
          >
            Compilers, Intelligent Systems, and Hardware-Software Co-Design.
          </h1>
          <p
            class="text-lg md:text-xl text-text-secondary mb-5 leading-relaxed animate-fade-in"
            style="animation-delay: 0.3s"
          >
            MPS Lab builds research systems that connect AI, compilers, embedded
            computing, quantum learning, and intelligent transportation into
            practical, high-impact tools.
          </p>
          <p
            class="text-sm md:text-base text-text-muted mb-7 leading-relaxed animate-fade-in"
            style="animation-delay: 0.35s"
          >
            We are actively looking for dedicated Undergraduate and Masters
            students. Reach out to Dr. Aviral Shrivastava at <a
              href="mailto:aviral.shrivastava@asu.edu"
              class="text-primary hover:text-primary-hover"
              >aviral.shrivastava@asu.edu</a
            >.
          </p>
          <div
            class="flex flex-wrap gap-4 animate-fade-in"
            style="animation-delay: 0.4s"
          >
            <a
              href="/research"
              class="inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3 font-medium text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-hover"
            >
              Explore Research
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
              >
            </a>
            <a
              href="/people"
              class="px-6 py-3 rounded-lg font-medium border border-primary/30 text-primary hover:text-primary-hover hover:border-primary-hover transition-colors duration-200"
            >
              Meet the Team
            </a>
          </div>
        </div>

        <div class="animate-fade-in" style="animation-delay: 0.45s">
          <HomepageCarousel images={homepageImages} client:load />
        </div>
      </div>
    </div>
  </section>

  <!-- Research Areas -->
  <section class="py-16 md:py-24 bg-bg-alt">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-text mb-4">
          Research Areas
        </h2>
        <p class="text-text-secondary max-w-2xl mx-auto">
          Our work spans multiple domains in computer science and engineering,
          with a focus on bridging the gap between hardware and software.
        </p>
      </div>
      <div class="text-center mb-10">
        <a href="/research" class="btn-primary inline-flex items-center gap-2">
          View All Research
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        {
          activeResearch.map((area, i) => {
            return (
              <a href={`/research/${area.slug}`} class="block group">
                <div
                  class="card h-full overflow-hidden hover:-translate-y-1 animate-slide-up transition-transform duration-300"
                  style={`animation-delay: ${i * 0.1}s`}
                >
                  {area.data.image && (
                    <div class="relative h-52 overflow-hidden bg-white p-3">
                      <img
                        src={area.data.image}
                        alt={area.data.title}
                        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-slate-950/15 to-transparent" />
                      <div class="absolute left-5 top-5 inline-flex items-center rounded-full border border-white/15 bg-black/30 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/80 backdrop-blur-sm">
                        Active Research
                      </div>
                    </div>
                  )}
                  <div class="p-6 flex flex-col h-full">
                    <h3 class="font-semibold text-lg text-text mb-2 group-hover:text-primary transition-colors">
                      {area.data.title}
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed flex-1">
                      {area.data.description}
                    </p>
                    <div class="mt-4 font-medium text-primary inline-flex items-center gap-1 text-sm group-hover:gap-2 transition-all">
                      Read more{" "}
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M17 8l4 4m0 0l-4 4m4-4H3"
                        />
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Latest News -->
  <section class="py-16 md:py-24">
    <div class="section-container">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-text mb-4">
          Latest News & Awards
        </h2>
        <p class="text-text-secondary">
          Stay updated with the latest from MPS Lab.
        </p>
      </div>
      <div
        class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-10"
      >
        {
          news.slice(0, 5).map((item) => (
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <span
                  class:list={[
                    "badge",
                    typeColors[item.data.type] ?? typeColors["General"],
                  ]}
                >
                  {item.data.type}
                </span>
                <time
                  class="text-xs text-text-muted"
                  datetime={new Date(item.data.date).toISOString()}
                >
                  {typeof item.data.date === "string" ||
                  typeof item.data.date === "number"
                    ? item.data.date
                    : new Date(item.data.date).toLocaleDateString("en-US", {
                        timeZone: "UTC",
                        year: "numeric",
                        month: "long",
                        day: "numeric",
                      })}
                </time>
              </div>
              {item.data.description && (
                <div
                  class="text-sm text-text-secondary leading-relaxed prose prose-sm dark:prose-invert"
                  set:html={item.data.description}
                />
              )}
            </div>
          ))
        }
      </div>
      <div class="text-center">
        <a href="/news" class="btn-primary inline-flex items-center gap-2">
          View all news
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Sponsors Section -->
  <section class="py-16 md:py-20 border-t border-border">
    <div class="section-container">
      <div class="text-center mb-10">
        <h2 class="text-2xl md:text-3xl font-bold text-text mb-3">
          Our Sponsors
        </h2>
        <p class="text-text-secondary max-w-xl mx-auto">
          We gratefully acknowledge the support of our funding agencies and
          industry partners.
        </p>
      </div>
      <div
        class="flex flex-wrap items-center justify-center gap-6 md:gap-8 max-w-5xl mx-auto"
      >
        {
          sponsors.map((s: any) => {
            const card = (
              <div
                title={s.name}
                class="bg-white rounded-xl px-5 py-3 shadow-sm border border-gray-100 hover:shadow-md hover:scale-105 transition-all duration-300 flex items-center justify-center"
              >
                <img
                  src={s.logo}
                  alt={s.name}
                  class="h-8 md:h-10 w-auto object-contain max-w-[120px]"
                />
              </div>
            );
            return s.url ? (
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                {card}
              </a>
            ) : (
              card
            );
          })
        }
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

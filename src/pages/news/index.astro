---
import { getCollection } from "astro:content";
import Footer from "../../components/astro/Footer.astro";
import Navbar from "../../components/astro/Navbar.astro";
import NewsSidebar from "../../components/astro/NewsSidebar.astro";
import Layout from "../../layouts/Layout.astro";

// Fetch all news and filter out awards, then sort by date descending
const allNews = await getCollection("news");
const labUpdates = allNews
    .filter((item) => item.data.type !== "Award")
    .sort(
        (a, b) =>
            new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
    );

// Group updates by year
const groupedUpdates = labUpdates.reduce(
    (acc, item) => {
        const dateStr = String(item.data.date);
        const year = dateStr.includes("-")
            ? dateStr.substring(0, 4)
            : new Date(item.data.date).toISOString().substring(0, 4);

        if (!acc[year]) {
            acc[year] = [];
        }
        acc[year].push(item);
        return acc;
    },
    {} as Record<string, typeof labUpdates>,
);

const sortedYears = Object.keys(groupedUpdates).sort(
    (a, b) => parseInt(b) - parseInt(a),
);

const typeColors: Record<string, string> = {
    Publication:
        "bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300",
    Event: "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300",
    Announcement:
        "bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300",
    General: "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400",
};

const currentPath = Astro.url.pathname;
---

<Layout title="Lab Updates - MPS Lab">
    <Navbar slot="header" />

    <div class="bg-hero text-hero-text py-16 md:py-24 relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
            <div
                class="absolute inset-0"
                style="background-image: radial-gradient(circle at 75% 25%, rgba(140, 29, 64, 0.3) 0%, transparent 50%);"
            >
            </div>
        </div>
        <div class="section-container relative z-10">
            <h1 class="text-4xl md:text-5xl font-extrabold mb-4">
                Lab Updates
            </h1>
            <p class="text-lg text-hero-text/80 max-w-2xl">
                The latest news, publications, and announcements from the MPS
                Lab.
            </p>
        </div>
    </div>

    <section class="py-12 bg-bg flex-grow">
        <div class="section-container">
            <div class="flex flex-col md:flex-row gap-8">
                <NewsSidebar currentPath={currentPath} />

                <div class="flex-1">
                    <div class="grid grid-cols-1 gap-6">
                        {
                            sortedYears.map((year, index) => (
                                <details
                                    class="mb-12 last:mb-0 group/details"
                                    open={index === 0}
                                >
                                    <summary class="text-2xl font-bold text-text mb-6 flex items-center justify-between gap-3 cursor-pointer list-none hover:text-primary transition-colors select-none [&::-webkit-details-marker]:hidden">
                                        <div class="flex items-center gap-3">
                                            <span class="w-1 h-8 bg-primary rounded-full" />
                                            {year}
                                        </div>
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            class="w-6 h-6 transition-transform duration-300 group-open/details:-rotate-180"
                                            viewBox="0 0 20 20"
                                            fill="currentColor"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </summary>
                                    <div class="grid grid-cols-1 gap-6 pt-2">
                                        {groupedUpdates[year].map((item) => (
                                            <div class="card p-6 border-l-4 border-l-primary hover:translate-y-0 hover:shadow-lg transition-all duration-300 group">
                                                <div class="flex items-center gap-3 mb-3">
                                                    <span
                                                        class:list={[
                                                            "badge",
                                                            typeColors[
                                                                item.data.type
                                                            ] ??
                                                                typeColors[
                                                                    "General"
                                                                ],
                                                        ]}
                                                    >
                                                        {item.data.type}
                                                    </span>
                                                    <time
                                                        class="text-sm font-medium text-text-secondary"
                                                        datetime={new Date(
                                                            item.data.date,
                                                        ).toISOString()}
                                                    >
                                                        {typeof item.data
                                                            .date ===
                                                            "string" ||
                                                        typeof item.data
                                                            .date === "number"
                                                            ? item.data.date
                                                            : new Date(
                                                                  item.data
                                                                      .date,
                                                              ).toLocaleDateString(
                                                                  "en-US",
                                                                  {
                                                                      timeZone:
                                                                          "UTC",
                                                                      year: "numeric",
                                                                      month: "short",
                                                                  },
                                                              )}
                                                    </time>
                                                </div>
                                                {item.data.description && (
                                                    <div
                                                        class="text-text-secondary leading-relaxed max-w-3xl prose prose-sm dark:prose-invert"
                                                        set:html={
                                                            item.data
                                                                .description
                                                        }
                                                    />
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                </details>
                            ))
                        }

                        {
                            sortedYears.length === 0 && (
                                <div class="text-center py-12 text-text-muted">
                                    <p>No lab updates found.</p>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</Layout>

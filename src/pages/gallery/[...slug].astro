---
import { getCollection } from "astro:content";
import { Calendar, ChevronLeft, MapPin } from "lucide-react";
import Footer from "../../components/astro/Footer.astro";
import Navbar from "../../components/astro/Navbar.astro";
import GalleryGrid from "../../components/react/GalleryGrid";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const galleryEntries = await getCollection("gallery");
    return galleryEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("en-US", {
        day: "numeric",
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<Layout title={entry.data.title}>
    <Navbar slot="header" />

    <section class="py-16 md:py-24 bg-bg">
        <div class="section-container">
            <a
                href="/gallery"
                class="inline-flex items-center gap-2 text-sm font-medium text-text-muted hover:text-primary transition-colors mb-12 group"
            >
                <ChevronLeft
                    className="w-4 h-4 transition-transform group-hover:-translate-x-1"
                />
                Back to Gallery
            </a>

            <div class="max-w-4xl mb-16">
                <div
                    class="flex flex-wrap items-center gap-4 text-sm font-medium text-primary mb-4 bg-primary/5 w-fit px-4 py-1.5 rounded-full"
                >
                    <span class="flex items-center gap-1.5">
                        <Calendar className="w-4 h-4" />
                        {formatDate(entry.data.date)}
                    </span>
                    {
                        entry.data.location && (
                            <span class="flex items-center gap-1.5 before:content-['•'] before:text-primary/30 before:mr-2">
                                <MapPin className="w-4 h-4" />
                                {entry.data.location}
                            </span>
                        )
                    }
                </div>

                <h1
                    class="text-4xl md:text-5xl font-bold text-text mb-6 tracking-tight leading-tight"
                >
                    {entry.data.title}
                </h1>

                <div
                    class="prose prose-lg dark:prose-invert max-w-none text-text-secondary leading-relaxed mb-12"
                >
                    <Content />
                </div>
            </div>

            <GalleryGrid images={entry.data.images} client:load />
        </div>
    </section>

    <Footer slot="footer" />
</Layout>

---
import { getCollection } from "astro:content";
import { Calendar, Camera, MapPin } from "lucide-react";
import Footer from "../../components/astro/Footer.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Layout from "../../layouts/Layout.astro";

const events = await getCollection("gallery");
const sortedEvents = events.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (date: Date) => {
    return new Intl.DateTimeFormat("en-US", {
        month: "long",
        year: "numeric",
    }).format(date);
};
---

<Layout title="Lab Gallery">
    <Navbar slot="header" />

    <section class="py-16 md:py-24 bg-bg">
        <div class="section-container">
            <div class="max-w-3xl mb-16">
                <h1
                    class="text-4xl md:text-5xl font-bold text-text mb-6 tracking-tight"
                >
                    Lab Gallery
                </h1>
                <p class="text-xl text-text-secondary leading-relaxed">
                    A collection of moments from our lab's journey—research
                    conferences, team outings, and social events.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    sortedEvents.map((event) => (
                        <a
                            href={`/gallery/${event.slug}`}
                            class="group flex flex-col bg-bg-card rounded-2xl overflow-hidden border border-border hover:shadow-xl hover:shadow-primary/5 transition-all duration-300 transform hover:-translate-y-1"
                        >
                            <div class="relative aspect-[16/9] overflow-hidden">
                                <img
                                    src={event.data.coverImage}
                                    alt={event.data.title}
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
                                    <span class="text-white text-sm font-medium flex items-center gap-2">
                                        <Camera className="w-4 h-4" />
                                        View {event.data.images.length} photos
                                    </span>
                                </div>
                            </div>

                            <div class="p-6 flex flex-col flex-1">
                                <div class="flex items-center gap-4 text-xs font-medium text-text-muted mb-3">
                                    <span class="flex items-center gap-1">
                                        <Calendar className="w-3.5 h-3.5" />
                                        {formatDate(event.data.date)}
                                    </span>
                                    {event.data.location && (
                                        <span class="flex items-center gap-1">
                                            <MapPin className="w-3.5 h-3.5" />
                                            {event.data.location}
                                        </span>
                                    )}
                                </div>

                                <h2 class="text-xl font-bold text-text mb-2 group-hover:text-primary transition-colors">
                                    {event.data.title}
                                </h2>
                                <p class="text-sm text-text-secondary line-clamp-2 leading-relaxed">
                                    {event.data.description}
                                </p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</Layout>

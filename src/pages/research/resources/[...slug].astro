---
import { getCollection } from "astro:content";
import { BookOpen, ExternalLink } from "lucide-react";
import Footer from "../../../components/astro/Footer.astro";
import Navbar from "../../../components/astro/Navbar.astro";
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
    const researchEntries = await getCollection("research");
    return researchEntries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;

// Find the matching resources file for this research area
const allResources = await getCollection("resources");
const resourceEntry = allResources.find(
    (r) => r.data.researchArea === entry.data.title,
);
const items = resourceEntry?.data.resources ?? [];

// Group by type
const resourceTypes = [
    "Paper",
    "Book",
    "Video",
    "Tutorial",
    "Tool",
    "Publication",
] as const;
const grouped = resourceTypes
    .map((type) => ({
        type,
        items: items.filter((r) => r.type === type),
    }))
    .filter((g) => g.items.length > 0);

const typeIcons: Record<string, string> = {
    Paper: "📄",
    Book: "📚",
    Video: "🎥",
    Tutorial: "📝",
    Tool: "🛠️",
    Publication: "📰",
};
---

<Layout title={`Reading List — ${entry.data.title}`}>
    <Navbar slot="header" />

    <section class="py-16 md:py-24">
        <div class="section-container max-w-4xl">
            <!-- Back Link -->
            <a
                href={`/research/${entry.slug}`}
                class="inline-flex items-center text-sm text-text-muted hover:text-primary transition-colors mb-8"
            >
                <svg
                    class="w-4 h-4 mr-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Back to {entry.data.title}
            </a>

            <!-- Header -->
            <header class="mb-12 border-b border-border pb-8">
                <div
                    class="inline-flex items-center justify-center w-12 h-12 bg-primary/10 rounded-xl mb-4"
                >
                    <BookOpen className="w-6 h-6 text-primary" />
                </div>
                <h1
                    class="text-3xl md:text-4xl font-bold text-text mb-4 tracking-tight"
                >
                    Reading List
                </h1>
                <p class="text-lg text-text-secondary leading-relaxed">
                    Curated resources for <strong class="text-text"
                        >{entry.data.title}</strong
                    > — research papers, books, videos, and more.
                </p>
            </header>

            {
                grouped.length === 0 ? (
                    <div class="text-center py-16">
                        <BookOpen className="w-12 h-12 mx-auto text-text-muted opacity-50 mb-4" />
                        <p class="text-text-muted text-lg">
                            No resources have been added yet.
                        </p>
                        <p class="text-text-muted text-sm mt-2">
                            Check back soon for curated reading materials.
                        </p>
                    </div>
                ) : (
                    <div class="space-y-12">
                        {grouped.map((group) => (
                            <div>
                                <h2 class="text-xl font-bold text-text mb-6 flex items-center gap-2">
                                    <span>{typeIcons[group.type] || "📌"}</span>
                                    {group.type === "Paper"
                                        ? "Papers"
                                        : `${group.type}s`}
                                </h2>
                                <div class="space-y-4">
                                    {group.items.map((resource) => (
                                        <div class="card p-5 group">
                                            <div class="flex items-start justify-between gap-4">
                                                <div class="flex-1 min-w-0">
                                                    <h3 class="font-semibold text-text group-hover:text-primary transition-colors leading-snug">
                                                        {resource.url ? (
                                                            <a
                                                                href={
                                                                    resource.url
                                                                }
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="hover:underline"
                                                            >
                                                                {resource.title}
                                                            </a>
                                                        ) : (
                                                            resource.title
                                                        )}
                                                    </h3>
                                                    {resource.authors && (
                                                        <p class="text-sm text-text-muted mt-1">
                                                            {resource.authors}
                                                        </p>
                                                    )}
                                                    {resource.description && (
                                                        <p class="text-sm text-text-secondary mt-2 leading-relaxed">
                                                            {
                                                                resource.description
                                                            }
                                                        </p>
                                                    )}
                                                </div>
                                                {resource.url && (
                                                    <a
                                                        href={resource.url}
                                                        target="_blank"
                                                        rel="noopener noreferrer"
                                                        class="flex-shrink-0 p-2 rounded-lg hover:bg-primary/10 text-text-muted hover:text-primary transition-all"
                                                        aria-label={`Open ${resource.title}`}
                                                    >
                                                        <ExternalLink className="w-4 h-4" />
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        ))}
                    </div>
                )
            }
        </div>
    </section>

    <Footer slot="footer" />
</Layout>

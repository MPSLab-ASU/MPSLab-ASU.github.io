---
import { getCollection } from "astro:content";
import {
  Battery,
  Binary,
  BookOpen,
  Brain,
  Car,
  CircuitBoard,
  Clock,
  Cpu,
  GitBranch,
  Grid3X3,
  MessageSquare,
  Monitor,
  Server,
  Shield,
  Thermometer,
  Wifi,
  Zap,
} from "lucide-react";
import Footer from "../../components/astro/Footer.astro";
import Navbar from "../../components/astro/Navbar.astro";
import Layout from "../../layouts/Layout.astro";

const allResearch = await getCollection("research");
allResearch.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const activeResearch = allResearch.filter((r) => r.data.status === "Active");
const extendedResearch = allResearch.filter(
  (r) => r.data.status === "Extended",
);

const IconMap: Record<string, any> = {
  Cpu,
  Car,
  BookOpen,
  Brain,
  Shield,
  Zap,
  Monitor,
  Wifi,
  Server,
  GitBranch,
  Grid3X3,
  Thermometer,
  CircuitBoard,
  Binary,
  Clock,
  MessageSquare,
  Battery,
};
---

<Layout title="Research">
  <Navbar slot="header" />

  <section class="py-16 md:py-24">
    <div class="section-container">
      <div class="text-center mb-16">
        <h1 class="text-3xl md:text-5xl font-bold text-text mb-6">
          Research Areas
        </h1>
        <p class="text-lg text-text-secondary max-w-3xl mx-auto">
          The Make Programming Simple (MPS) Lab focuses on advancing
          computational methods and technologies to simplify programming and
          enhance system performance across diverse domains.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="#active-research"
            class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
          >
            Jump to Active Research
          </a>
          <a
            href="#extended-research"
            class="px-4 py-2 rounded-lg text-sm font-medium bg-bg-alt text-text-secondary hover:bg-primary/10 hover:text-primary transition-colors"
          >
            Jump to Extended Research
          </a>
        </div>
      </div>

      <!-- Active Research -->
      <div id="active-research" class="mb-20 scroll-mt-28">
        <h2 class="text-2xl font-bold text-text mb-8 flex items-center gap-3">
          <span class="w-1 h-8 bg-green-500 rounded-full"></span>
          Active Research
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
          {
            activeResearch.map((area) => {
              return (
                <a href={`/research/${area.slug}`} class="block group">
                  <div class="card h-full overflow-hidden hover:-translate-y-2 transition-transform duration-300">
                    {area.data.image && (
                      <div class="relative h-64 overflow-hidden bg-white p-4">
                        <img
                          src={area.data.image}
                          alt={area.data.title}
                          class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                          loading="lazy"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent" />
                        <div class="absolute left-6 top-6 inline-flex items-center rounded-full border border-white/15 bg-black/30 px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.22em] text-white/85 backdrop-blur-sm">
                          Active Research
                        </div>
                      </div>
                    )}
                    <div class="p-8 flex flex-col h-full">
                      <h3 class="font-bold text-xl text-text mb-3 group-hover:text-primary transition-colors">
                        {area.data.title}
                      </h3>
                      <p class="text-text-secondary leading-relaxed flex-1">
                        {area.data.description}
                      </p>
                      <div class="mt-6 font-medium text-primary inline-flex items-center gap-2 group-hover:gap-3 transition-all">
                        Read more{" "}
                        <svg
                          class="w-4 h-4"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                          />
                        </svg>
                      </div>
                    </div>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>

      <!-- Extended Research -->
      <div id="extended-research" class="scroll-mt-28">
        <h2 class="text-2xl font-bold text-text mb-8 flex items-center gap-3">
          <span class="w-1 h-8 bg-blue-500 rounded-full"></span>
          Extended Research
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            extendedResearch.map((area) => {
              const IconComponent = area.data.icon
                ? IconMap[area.data.icon]
                : Shield;
              return (
                <a href={`/research/${area.slug}`} class="block group">
                  <div class="card p-6 h-full flex flex-col hover:-translate-y-1 transition-transform duration-300">
                    <div class="w-10 h-10 bg-bg-alt rounded-lg flex items-center justify-center mb-4">
                      <IconComponent className="w-5 h-5 text-text-muted group-hover:text-primary transition-colors" />
                    </div>
                    <h3 class="font-semibold text-lg text-text mb-2 group-hover:text-primary transition-colors">
                      {area.data.title}
                    </h3>
                    <p class="text-sm text-text-secondary leading-relaxed flex-1">
                      {area.data.description}
                    </p>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

---
import { getCollection } from "astro:content";
import { marked } from "marked";
import Footer from "../components/astro/Footer.astro";
import Navbar from "../components/astro/Navbar.astro";
import Layout from "../layouts/Layout.astro";

const faqs = await getCollection("faq");
const faqData = faqs
    .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
    .map((entry) => entry.data);

const categoryIcons: Record<string, string> = {
    "Contact the MPS Lab": "📍",
    Research: "📝",
    "On-Campus Resources": "🏫",
    Administrative: "📋",
    General: "💡",
};
---

<Layout title="FAQ">
    <Navbar slot="header" />

    <section class="py-16 md:py-24">
        <div class="section-container max-w-4xl">
            <div class="text-center mb-12">
                <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">
                    Frequently Asked Questions
                </h1>
                <p class="text-text-secondary max-w-2xl mx-auto">
                    Quick answers and helpful resources for current and
                    prospective lab members.
                </p>
            </div>

            <!-- Category Navigation Pills -->
            <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
                {
                    faqData.map((section: any, i: number) => (
                        <a
                            href={`#faq-section-${i}`}
                            class="px-4 py-2 rounded-full text-sm font-medium border border-[var(--color-border)] bg-[var(--color-bg-card)] text-[var(--color-text-secondary)] hover:bg-[var(--color-primary)] hover:text-white hover:border-transparent transition-all"
                        >
                            <span class="mr-1.5">
                                {categoryIcons[section.category] || "❓"}
                            </span>
                            {section.category}
                        </a>
                    ))
                }
            </div>

            <!-- FAQ Sections -->
            <div class="space-y-10">
                {
                    faqData.map((section: any, sectionIdx: number) => (
                        <div
                            id={`faq-section-${sectionIdx}`}
                            class="scroll-mt-24"
                        >
                            <h2 class="text-xl font-bold text-text mb-5 flex items-center gap-3">
                                <span class="text-2xl">
                                    {categoryIcons[section.category] || "❓"}
                                </span>
                                {section.category}
                            </h2>
                            <div class="space-y-3">
                                {section.items.map((item: any) => {
                                    const hasAnswer =
                                        item.answer && item.answer.length > 0;
                                    const hasExternal =
                                        item.externalLink &&
                                        item.externalLink.length > 0;
                                    const hasContent = hasAnswer || hasExternal;

                                    return (
                                        <details class="faq-item group rounded-xl border border-transparent bg-transparent overflow-hidden">
                                            <summary class="flex items-start gap-3 px-5 py-4 cursor-pointer select-none list-none hover:bg-[var(--color-bg-alt)] transition-colors">
                                                <svg
                                                    class="w-5 h-5 mt-0.5 text-[var(--color-text-muted)] group-open:rotate-90 transition-transform flex-shrink-0"
                                                    fill="none"
                                                    stroke="currentColor"
                                                    viewBox="0 0 24 24"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d="M9 5l7 7-7 7"
                                                    />
                                                </svg>
                                                <span class="font-medium text-[var(--color-text)] leading-snug flex-1">
                                                    {item.question}
                                                </span>
                                                {/* Badge indicating link type */}
                                                {hasExternal && !hasAnswer && (
                                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300 flex-shrink-0 mt-0.5">
                                                        <svg
                                                            class="w-3 h-3"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                            />
                                                        </svg>
                                                        External
                                                    </span>
                                                )}
                                            </summary>

                                            <div class="px-5 pb-4 pt-1 ml-8 space-y-3">
                                                {/* Inline answer content with Markdown Support */}
                                                {hasAnswer && (
                                                    <div
                                                        class="text-sm text-[var(--color-text-secondary)] leading-relaxed prose prose-sm dark:prose-invert max-w-none"
                                                        set:html={marked.parse(
                                                            item.answer,
                                                        )}
                                                    />
                                                )}

                                                {/* External resource link */}
                                                {hasExternal && (
                                                    <div class="flex items-start gap-3 p-3 rounded-lg bg-[var(--color-bg-alt)] border border-[var(--color-border)]">
                                                        <svg
                                                            class="w-5 h-5 text-[var(--color-primary)] flex-shrink-0 mt-0.5"
                                                            fill="none"
                                                            stroke="currentColor"
                                                            viewBox="0 0 24 24"
                                                        >
                                                            <path
                                                                stroke-linecap="round"
                                                                stroke-linejoin="round"
                                                                stroke-width="2"
                                                                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                                            />
                                                        </svg>
                                                        <div class="min-w-0">
                                                            <p class="text-xs font-medium text-[var(--color-text-muted)] uppercase tracking-wider mb-1">
                                                                External
                                                                Resource
                                                            </p>
                                                            <a
                                                                href={
                                                                    item.externalLink
                                                                }
                                                                target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="text-sm text-[var(--color-primary)] hover:underline font-medium break-all"
                                                            >
                                                                {item
                                                                    .externalLink
                                                                    .length > 60
                                                                    ? item.externalLink.substring(
                                                                          0,
                                                                          60,
                                                                      ) + "…"
                                                                    : item.externalLink}
                                                            </a>
                                                        </div>
                                                    </div>
                                                )}

                                                {/* Fallback for truly self-contained items */}
                                                {!hasContent && (
                                                    <p class="text-sm text-[var(--color-text-secondary)] italic">
                                                        See the information in
                                                        the question above.
                                                    </p>
                                                )}
                                            </div>
                                        </details>
                                    );
                                })}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <Footer slot="footer" />
</Layout>

<style>
    details summary::-webkit-details-marker {
        display: none;
    }
</style>
